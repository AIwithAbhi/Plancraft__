{
  "name": "plancraft-experiments",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evals": "NODE_OPTIONS='--conditions=react-server' tsx evals/run.ts",
    "db:generate": "NODE_OPTIONS='--conditions=react-server' drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS='--conditions=react-server' tsx scripts/migrate.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm evals"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@electric-sql/pglite": "^0.3.14",
    "@neondatabase/serverless": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "next": "16.4.3",
    "posthog-js": "^1.280.1",
    "posthog-node": "^5.9.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
